/* Basic Styles */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f4f4f4;
}

header {
    background: #000;
    color: #fff;
    padding: 15px 20px;
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1000px;
    margin: 0 auto;
}

.logo {
    color: #fff;
    text-decoration: none;
    font-size: 20px;
    font-weight: bold;
}

nav button {
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    font-size: 16px;
    margin-left: 15px;
}

nav button.active {
    text-decoration: underline;
}

.container {
    max-width: 1000px;
    margin: 30px auto;
    background: #fff;
    padding: 20px;
    min-height: 400px;
    border-radius: 5px;
}

/* Page visibility */
.page {
    display: none;
}

.page.active {
    display: block;
}

/* Hero section */
.hero-section {
    text-align: center;
    padding: 50px 20px;
}

.btn {
    background: #000;
    color: #fff;
    padding: 10px 20px;
    border: none;
    cursor: pointer;
    font-size: 16px;
    margin-top: 15px;
}

.btn:hover {
    background: #444;
}

/* Products Grid */
.products-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 20px;
}

.product-card {
    border: 1px solid #ddd;
    padding: 15px;
    width: 30%;
    text-align: center;
    border-radius: 5px;
}

.product-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
}

/* Cart */
.cart-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid #ddd;
}

.cart-total {
    margin-top: 20px;
    text-align: right;
}

footer {
    text-align: center;
    padding: 15px;
    color: #777;
    font-size: 14px;
}